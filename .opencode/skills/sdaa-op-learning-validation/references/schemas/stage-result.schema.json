{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teco.example/schemas/sdaa-stage-result.schema.json",
  "title": "SDAA learning-validation stage result",
  "type": "object",
  "required": [
    "schema_version",
    "backend",
    "topic",
    "stage",
    "target_op",
    "attempt_type",
    "hypothesis",
    "status",
    "allowed_changes",
    "forbidden_changes",
    "verified_shapes",
    "failures",
    "learned_rules",
    "result_classification"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "backend": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "stage": {"type": "string", "minLength": 1},
    "target_op": {"type": "string", "minLength": 1},
    "attempt_type": {
      "enum": ["isolated", "enabler", "combination", "ablation"]
    },
    "hypothesis": {"type": "string", "minLength": 1},
    "goal": {"type": "string"},
    "status": {"type": "string", "minLength": 1},
    "components": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "dependencies": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "baseline_stage": {"type": ["string", "null"]},
    "comparison_matrix": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["variant"],
        "properties": {
          "variant": {"type": "string"},
          "stage": {"type": "string"},
          "result": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "ablation_plan": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "allowed_changes": {"type": "array", "items": {"type": "string"}},
    "forbidden_changes": {"type": "array", "items": {"type": "string"}},
    "verified_shapes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "commands": {"type": "array"},
    "correctness": {"type": "object"},
    "delivery": {"type": "object"},
    "pipeline": {"type": "object"},
    "perf_before": {"type": ["object", "null"]},
    "perf_after": {"type": ["object", "null"]},
    "failures": {"type": "array"},
    "failure_root_cause": {"type": "string"},
    "fix": {"type": "string"},
    "learned_rules": {"type": "array", "items": {"type": "string"}},
    "result_classification": {
      "enum": [
        "positive_alone",
        "neutral_enabler",
        "negative_alone",
        "positive_in_bundle",
        "incompatible"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"attempt_type": {"const": "combination"}}},
      "then": {
        "required": [
          "components",
          "dependencies",
          "baseline_stage",
          "comparison_matrix",
          "ablation_plan"
        ]
      }
    }
  ],
  "additionalProperties": true
}
