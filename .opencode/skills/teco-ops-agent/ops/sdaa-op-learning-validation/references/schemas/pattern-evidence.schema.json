{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://teco.example/schemas/sdaa-pattern-evidence.schema.json",
  "title": "SDAA portable pattern evidence registry",
  "type": "object",
  "required": ["schema_version", "evidence"],
  "properties": {
    "schema_version": {"const": 1},
    "evidence": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "backend",
          "stage",
          "target_op",
          "status",
          "correctness_passed",
          "delivery_passed",
          "verified_shapes",
          "source_stage"
        ],
        "properties": {
          "backend": {"type": "string"},
          "hardware": {"type": ["string", "null"]},
          "source_revision": {"type": ["string", "null"]},
          "topic": {"type": "string"},
          "stage": {"type": "string"},
          "target_op": {"type": "string"},
          "status": {"type": "string"},
          "attempt_type": {
            "enum": ["isolated", "enabler", "combination", "ablation"]
          },
          "result_classification": {
            "enum": [
              "positive_alone",
              "neutral_enabler",
              "negative_alone",
              "positive_in_bundle",
              "incompatible"
            ]
          },
          "correctness_passed": {"type": "boolean"},
          "delivery_passed": {"type": "boolean"},
          "verified_shapes": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1
          },
          "performance": {
            "type": ["object", "null"],
            "properties": {
              "metric": {"type": "string"},
              "unit": {"type": "string"},
              "before": {"type": "number"},
              "after": {"type": "number"},
              "direction": {"enum": ["lower_is_better", "higher_is_better"]}
            },
            "required": ["metric", "unit", "before", "after", "direction"],
            "additionalProperties": true
          },
          "source_stage": {
            "type": "string",
            "pattern": "^backend://[a-z0-9][a-z0-9_.-]*/.+/stage_results/[A-Za-z0-9_.-]+\\.json$"
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
