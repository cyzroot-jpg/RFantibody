  "operator_definition": {
    "priority": "P0",
    "status": "defined",
    "summary": "fp16 RMSNorm forward; fp32 acc for reduction; rowwise two-pass design.",
    "computation_type": "normalization",
    "operator_family": "rowwise_norm",
    "formula": "inv_rms = rsqrt(mean(x^2) + eps); y = x * inv_rms * weight",
    "logic_steps": [
      "Pass1: read x tile, accumulate fp32 square sum per row, write inv_rms",
      "Pass2: read x tile + weight tile, normalize and write y"
    ],
    "io_tensors": [
      {"name": "x", "dtype": "float16", "shape": "[rows, cols]", "desc": "input"},
      {"name": "weight", "dtype": "float16", "shape": "[cols]", "desc": "scale"},
      {"name": "y", "dtype": "float16", "shape": "[rows, cols]", "desc": "output"},
      {"name": "inv_rms", "dtype": "float32", "shape": "[rows]", "desc": "debug/golden"}
    ],
    "kernel_apis": ["batch_H2S", "batch_Smul", "reduce_Ssum", "batch_Smul_a", "batch_S2H"],
    "independent_axes": ["rows"],
    "reduction_axes": ["cols"],
    "reuse_axes": ["weight@cols"]
  },
