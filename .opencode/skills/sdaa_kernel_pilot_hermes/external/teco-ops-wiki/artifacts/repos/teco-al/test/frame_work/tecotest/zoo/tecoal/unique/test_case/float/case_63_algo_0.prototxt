    dims: 5
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
  random_data {
    seed: 20147582
    lower_bound: -100.0
    upper_bound: 100.0
    distribution: UNIFORM
  }
  ttype: TENSOR
}
input {
  id: "y"
  shape {
    dims: 120
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
  reused: true
  random_data {
    seed: 90707465
    lower_bound: -100.0
    upper_bound: 100.0
    distribution: UNIFORM
  }
  ttype: TENSOR
}
input {
  id: "inverse"
  shape {
    dims: 6
    dims: 2
    dims: 2
    dims: 5
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT64
  reused: true
  random_data {
    seed: 79569796
    lower_bound: -100.0
    upper_bound: 100.0
    distribution: UNIFORM
  }
  ttype: TENSOR
}
input {
  id: "counts"
  shape {
    dims: 120
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT64
  reused: true
  random_data {
    seed: 9138908
    lower_bound: -100.0
    upper_bound: 100.0
