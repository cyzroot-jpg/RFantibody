#include "ual/kernel/add_tensor/add_tensor.h"
#include "ual/kernel/macro.h"
#include "ual/com/rt.h"

using namespace sdaa;
using namespace tecoal::ual::common;

namespace tecoal {
namespace ual {
namespace kernel {

#define MAX(a, b) ((a) >= (b) ? (a) : (b))
#define MIN(a, b) ((a) <= (b) ? (a) : (b))

// double buffer: current addr, another addr, exchange flag
#define CDBUF(x) (x[x##_dbflag])
#define ADBUF(x) (x[1 - x##_dbflag])
#define EXDBF(x) x##_dbflag = 1 - x##_dbflag

typedef _Float16 half;

// DataType : half
// N*H*W*C%2 == 0

__global__ void tecoKernelAddTensorHalfSingleThread(AddTensorArgs arg) {
    // Get args value
    const int data_num = arg.c_n_num * arg.c_hw_num * arg.a_c_num;
    const float alpha = arg.alpha;
    const float beta = arg.beta;

    // Cast A, C to _Float16 pointer
    _Float16 *A = (_Float16 *)arg.A;
    _Float16 *C = (_Float16 *)arg.C;

    if (threadIdx == 0) {
        for (int i = 0; i < data_num; i++) {
            C[i] = C[i] * beta + A[i] * alpha;
        }
    }
}

__global__ void tecoKernelAddTensorHalfMultiThreads(AddTensorArgs arg) {
    // Get args value
    const int spe_num = arg.spe_num;
    const int data_num = arg.c_n_num * arg.c_hw_num * arg.a_c_num;
    const float alpha = arg.alpha;
    const float beta = arg.beta;

    // Cast A, C to _Float16 pointer
    _Float16 *A = (_Float16 *)arg.A;
    _Float16 *C = (_Float16 *)arg.C;

    // Calculate the number of elements each core should handle
    size_t per_spe_num = (data_num + spe_num - 1) / spe_num;

    // Calculate the starting index and the ending index for the current thread
    size_t start = threadIdx * per_spe_num;
    const int end = MIN(start + per_spe_num, data_num);

    for (int i = start; i < end; i++) {
        C[i] = C[i] * beta + A[i] * alpha;
    }
}

__global__ void tecoKernelAddTensorHalfDMA(AddTensorArgs arg) {
    // Get args value
    const int spe_num = arg.spe_num;
    const int data_num = arg.c_n_num * arg.c_hw_num * arg.a_c_num;
    const float alpha = arg.alpha;
    const float beta = arg.beta;

    // Cast A, C to _Float16 pointer
    _Float16 *A = (_Float16 *)arg.A;
    _Float16 *C = (_Float16 *)arg.C;

    // Calculate the number of elements each core should handle
    size_t per_spe_num = (data_num + spe_num - 1) / spe_num;

    // Calculate the starting index and the ending index for the current thread
    size_t start = threadIdx * per_spe_num;
    const int end = MIN(start + per_spe_num, data_num);
    if (end <= start) return;

    // Define the maximum block size for double buffer
    const int MAX_BLK = 78 * 1024;
    const int max_blk = MAX_BLK / sizeof(half);

    // Define double buffer arrays for A, C
    half *a_buf;
    half *c_buf_in;
    half *c_buf_out;

    // Allocate memory for A, C buffer
    a_buf = (half *)rt_spm_malloc(MAX_BLK);
    c_buf_in = (half *)rt_spm_malloc(MAX_BLK);
    c_buf_out = (half *)rt_spm_malloc(MAX_BLK);

    for (int i = start; i < end; i += max_blk) {
        const int curr_blk = MIN(max_blk, end - i);

        memcpy(a_buf, A + i, curr_blk * sizeof(half));
        memcpy(c_buf_in, C + i, curr_blk * sizeof(half));

        // Perform tensor addition operation for the current block
        for (int ii = 0; ii < curr_blk; ii += 1) {
            *(c_buf_out + ii) = (*(c_buf_in + ii)) * beta + (*(a_buf + ii)) * alpha;
        }

        // Copy the updated data from shared memory back to global memory
        memcpy(C + i, c_buf_out, curr_blk * sizeof(half));
    }

    // Free the allocated memory for double buffer arrays
    rt_spm_free(a_buf);
    rt_spm_free(c_buf_in);
    rt_spm_free(c_buf_out);
    return;
}

__global__ void tecoKernelAddTensorHalfSIMD(AddTensorArgs arg) {
    // Get args value
    const int spe_num = arg.spe_num;
    const int data_num = arg.c_n_num * arg.c_hw_num * arg.a_c_num;
    const float alpha = arg.alpha;
    const float beta = arg.beta;

    // Cast A, C to _Float16 pointer
    _Float16 *A = (_Float16 *)arg.A;
    _Float16 *C = (_Float16 *)arg.C;

    // Calculate the number of elements each core should handle
    size_t per_spe_num = (data_num + spe_num - 1) / spe_num;

    // Vectorized variables
    floatv16 v_c_temp;
    float16v16 v_a, v_c;
    float16v16 v_alpha = alpha;
    float16v16 v_beta = beta;

    // Calculate the starting index and the ending index for the current thread
    size_t start = threadIdx * per_spe_num;
    const int end = MIN(start + per_spe_num, data_num);
    if (end <= start) return;

    // Define the maximum block size for double buffer
    const int MAX_BLK = 78 * 1024;
    const int max_blk = MAX_BLK / sizeof(half);

    // Define double buffer arrays for A, C
    half *a_buf;
    half *c_buf_in;
    half *c_buf_out;

    // Allocate memory for A, C buffer
    a_buf = (half *)rt_spm_malloc(MAX_BLK);
    c_buf_in = (half *)rt_spm_malloc(MAX_BLK);
    c_buf_out = (half *)rt_spm_malloc(MAX_BLK);

    for (int i = start; i < end; i += max_blk) {
        const int curr_blk = MIN(max_blk, end - i);

        memcpy(a_buf, A + i, curr_blk * sizeof(half));
        memcpy(c_buf_in, C + i, curr_blk * sizeof(half));

        // Perform tensor addition operation for the current block
        for (int ii = 0; ii < curr_blk; ii += 16) {
            simd_load(v_a, a_buf + ii);
            simd_load(v_c, c_buf_in + ii);
            v_c_temp = v_c * v_beta + v_a * v_alpha;
            v_c = simd_cvt_f2h(v_c_temp);
            simd_store(v_c, c_buf_out + ii);
        }

        // Copy the updated data from shared memory back to global memory
        memcpy(C + i, c_buf_out, curr_blk * sizeof(half));
    }

    // Free the allocated memory for double buffer arrays
    rt_spm_free(a_buf);
    rt_spm_free(c_buf_in);
    rt_spm_free(c_buf_out);
    return;
}

__global__ void tecoKernelAddTensorHalfUnroll(AddTensorArgs arg) {
    // Get args value
    const int spe_num = arg.spe_num;
    const int data_num = arg.c_n_num * arg.c_hw_num * arg.a_c_num;
    const float alpha = arg.alpha;
    const float beta = arg.beta;

    // Cast A, C to _Float16 pointer
    _Float16 *A = (_Float16 *)arg.A;
    _Float16 *C = (_Float16 *)arg.C;

    // Calculate the number of elements each core should handle
    size_t per_spe_num = (data_num + spe_num - 1) / spe_num;

    // Vectorized variables
    floatv16 v_c_temp[4];
    float16v16 v_a[4], v_c[4];
    float16v16 v_alpha = alpha;
    float16v16 v_beta = beta;

    // Calculate the starting index and the ending index for the current thread
    size_t start = threadIdx * per_spe_num;
    const int end = MIN(start + per_spe_num, data_num);
    if (end <= start) return;

    // Define the maximum block size for double buffer
    const int MAX_BLK = 78 * 1024;
    const int max_blk = MAX_BLK / sizeof(half);

    // Define double buffer arrays for A, C
    half *a_buf;
    half *c_buf_in;
    half *c_buf_out;

    // Allocate memory for A, C buffer
    a_buf = (half *)rt_spm_malloc(MAX_BLK);
    c_buf_in = (half *)rt_spm_malloc(MAX_BLK);
    c_buf_out = (half *)rt_spm_malloc(MAX_BLK);

    for (int i = start; i < end; i += max_blk) {
        const int curr_blk = MIN(max_blk, end - i);

        memcpy(a_buf, A + i, curr_blk * sizeof(half));
        memcpy(c_buf_in, C + i, curr_blk * sizeof(half));

        // Perform tensor addition operation for the current block
        for (int ii = 0; ii < curr_blk; ii += 64) {
            simd_load(v_a[0], a_buf + ii);
            simd_load(v_a[1], a_buf + ii + 16);
            simd_load(v_a[2], a_buf + ii + 32);
            simd_load(v_a[3], a_buf + ii + 48);
            simd_load(v_c[0], c_buf_in + ii);
            simd_load(v_c[1], c_buf_in + ii + 16);
            simd_load(v_c[2], c_buf_in + ii + 32);
            simd_load(v_c[3], c_buf_in + ii + 48);
            v_c_temp[0] = v_c[0] * v_beta + v_a[0] * v_alpha;
            v_c_temp[1] = v_c[1] * v_beta + v_a[1] * v_alpha;
            v_c_temp[2] = v_c[2] * v_beta + v_a[2] * v_alpha;
            v_c_temp[3] = v_c[3] * v_beta + v_a[3] * v_alpha;
            v_c[0] = simd_cvt_f2h(v_c_temp[0]);
            v_c[1] = simd_cvt_f2h(v_c_temp[1]);
            v_c[2] = simd_cvt_f2h(v_c_temp[2]);
            v_c[3] = simd_cvt_f2h(v_c_temp[3]);
            simd_store(v_c[0], c_buf_out + ii);
            simd_store(v_c[1], c_buf_out + ii + 16);
            simd_store(v_c[2], c_buf_out + ii + 32);
            simd_store(v_c[3], c_buf_out + ii + 48);
        }

        // Copy the updated data from shared memory back to global memory
        memcpy(C + i, c_buf_out, curr_blk * sizeof(half));
    }

    // Free the allocated memory for double buffer arrays
    rt_spm_free(a_buf);
    rt_spm_free(c_buf_in);
    rt_spm_free(c_buf_out);
    return;
}

__global__ void tecoKernelAddTensorHalfDoubleBuffer(AddTensorArgs arg) {
    // Get args value
    const int spe_num = arg.spe_num;
    const int data_num = arg.c_n_num * arg.c_hw_num * arg.a_c_num;
    const float alpha = arg.alpha;
    const float beta = arg.beta;

    // Cast A, C to _Float16 pointer
    _Float16 *A = (_Float16 *)arg.A;
    _Float16 *C = (_Float16 *)arg.C;

    // Calculate the number of elements each core should handle
    size_t per_spe_num = (data_num + spe_num - 1) / spe_num;

    // Vectorized variables
    floatv16 v_c_temp[4];
    float16v16 v_a[4], v_c[4];
    float16v16 v_alpha = alpha;
    float16v16 v_beta = beta;

    // Calculate the starting index and the ending index for the current thread
    size_t start = threadIdx * per_spe_num;
    const int end = MIN(start + per_spe_num, data_num);
    if (end <= start) return;

    // Define the maximum block size for double buffer
    const int MAX_BLK = 56 * 1024;
    const int max_blk = MAX_BLK / sizeof(half);

    // Define double buffer arrays for A, C
    half *a_buf[2];
    half *c_buf[2];

    // Flag for indicating the current buffer for A, C
    int a_buf_dbflag = 0;
    int c_buf_dbflag = 0;

    // Allocate memory for A, C buffer
    a_buf[0] = (half *)rt_spm_malloc(MAX_BLK);
    a_buf[1] = (half *)rt_spm_malloc(MAX_BLK);
    c_buf[0] = (half *)rt_spm_malloc(MAX_BLK);
    c_buf[1] = (half *)rt_spm_malloc(MAX_BLK);

    // Memory copy handles
    MemcpyHandle get_handle[2];
    MemcpyHandle put_handle;

    // Calculate the size of the next block
    int next_blk = MIN(max_blk, end - start);

    // Copy data from global memory to shared memory using double buffering
    memcpy_async(ADBUF(a_buf), A + start, next_blk * sizeof(half), MemcpyGlobalToSpm,
                 get_handle[a_buf_dbflag]);
    memcpy_async(ADBUF(c_buf), C + start, next_blk * sizeof(half), MemcpyGlobalToSpm,
                 get_handle[a_buf_dbflag]);

    for (int i = start; i < end; i += max_blk) {
        const int curr_blk = MIN(max_blk, end - i);
        next_blk = MIN(max_blk, end - i - max_blk);

        // Wait for the current block data to be copied from global memory to shared memory
        memcpy_wait(get_handle[a_buf_dbflag]);
        memcpy_wait(put_handle);

        // Exchange double buffer flags
        EXDBF(a_buf);
        EXDBF(c_buf);

        // Check if there's data for the next block
        if (next_blk > 0) {
            // Copy data for the next block from global memory to shared memory using double
            // buffering
            memcpy_async(ADBUF(a_buf), A + (i + max_blk), next_blk * sizeof(half),
                         MemcpyGlobalToSpm, get_handle[a_buf_dbflag]);
            memcpy_async(ADBUF(c_buf), C + (i + max_blk), next_blk * sizeof(half),
                         MemcpyGlobalToSpm, get_handle[a_buf_dbflag]);
        }

        // Perform tensor addition operation for the current block
        for (int ii = 0; ii < curr_blk; ii += 64) {
            simd_load(v_a[0], CDBUF(a_buf) + ii);
            simd_load(v_a[1], CDBUF(a_buf) + ii + 16);
            simd_load(v_a[2], CDBUF(a_buf) + ii + 32);
            simd_load(v_a[3], CDBUF(a_buf) + ii + 48);
            simd_load(v_c[0], CDBUF(c_buf) + ii);
            simd_load(v_c[1], CDBUF(c_buf) + ii + 16);
            simd_load(v_c[2], CDBUF(c_buf) + ii + 32);
            simd_load(v_c[3], CDBUF(c_buf) + ii + 48);
            v_c_temp[0] = v_c[0] * v_beta + v_a[0] * v_alpha;
            v_c_temp[1] = v_c[1] * v_beta + v_a[1] * v_alpha;
            v_c_temp[2] = v_c[2] * v_beta + v_a[2] * v_alpha;
            v_c_temp[3] = v_c[3] * v_beta + v_a[3] * v_alpha;
            v_c[0] = simd_cvt_f2h(v_c_temp[0]);
            v_c[1] = simd_cvt_f2h(v_c_temp[1]);
            v_c[2] = simd_cvt_f2h(v_c_temp[2]);
            v_c[3] = simd_cvt_f2h(v_c_temp[3]);
            simd_store(v_c[0], CDBUF(c_buf) + ii);
            simd_store(v_c[1], CDBUF(c_buf) + ii + 16);
            simd_store(v_c[2], CDBUF(c_buf) + ii + 32);
            simd_store(v_c[3], CDBUF(c_buf) + ii + 48);
        }

        // Copy the updated data from shared memory back to global memory
        memcpy_async(C + i, CDBUF(c_buf), curr_blk * sizeof(half), MemcpySpmToGlobal, put_handle);
    }

    memcpy_wait(put_handle);

    // Free the allocated memory for double buffer arrays
    rt_spm_free(a_buf[0]);
    rt_spm_free(a_buf[1]);
    rt_spm_free(c_buf[0]);
    rt_spm_free(c_buf[1]);
    return;
}

