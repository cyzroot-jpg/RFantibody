op_name: "unique"
input {
  id: "x"
  shape {
    dims: 1
    dims: 3
    dims: 15
    dims: 4
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT64
  random_data {
    seed: 28541335
    lower_bound: -100.0
    upper_bound: 100.0
    distribution: UNIFORM
  }
  ttype: TENSOR
}
input {
  id: "y"
  shape {
    dims: 180
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT64
  reused: true
  random_data {
    seed: 4676126
    lower_bound: -100.0
    upper_bound: 100.0
    distribution: UNIFORM
  }
  ttype: TENSOR
}
input {
  id: "inverse"
  shape {
    dims: 1
    dims: 3
    dims: 15
    dims: 4
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT64
  reused: true
  random_data {
    seed: 98082609
    lower_bound: -100.0
    upper_bound: 100.0
    distribution: UNIFORM
  }
  ttype: TENSOR
}
input {
  id: "counts"
  shape {
    dims: 180
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT64
  reused: true
  random_data {
    seed: 84275169
    lower_bound: -100.0
    upper_bound: 100.0
    distribution: UNIFORM
  }
  ttype: TENSOR
}
output {
  id: "out_size"
  shape {
    dims: 1
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT64
  ttype: VALID
}
tecoal_param {
  unique_param {
    sorted: true
    return_inverse: true
    return_counts: false
    mode: UNIQUE_NONE
    axis: 0
    algo: ALGO_0
  }
}
