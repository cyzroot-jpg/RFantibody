  dtype: DTYPE_INT64
  ttype: VALID
}
tecoal_param {
  unique_param {
    sorted: true
    return_inverse: true
    return_counts: true
    mode: UNIQUE_NONE
    axis: 0
    algo: ALGO_0
  }
}
