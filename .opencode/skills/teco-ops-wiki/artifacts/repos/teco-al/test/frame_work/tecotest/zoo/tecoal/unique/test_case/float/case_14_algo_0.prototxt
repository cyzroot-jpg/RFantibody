  shape {
    dims: 3
    dims: 2
    dims: 3
    dims: 6
    dims: 4
    dims: 1
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
  random_data {
    seed: 98511060
    lower_bound: -100.0
    upper_bound: 100.0
    distribution: UNIFORM
  }
  ttype: TENSOR
}
input {
  id: "y"
  shape {
    dims: 432
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_FLOAT
  reused: true
  random_data {
    seed: 46205042
    lower_bound: -100.0
    upper_bound: 100.0
    distribution: UNIFORM
  }
  ttype: TENSOR
}
input {
  id: "inverse"
  shape {
    dims: 3
    dims: 2
    dims: 3
    dims: 6
    dims: 4
    dims: 1
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT64
  reused: true
  random_data {
    seed: 16908106
    lower_bound: -100.0
    upper_bound: 100.0
    distribution: UNIFORM
  }
  ttype: TENSOR
}
input {
  id: "counts"
  shape {
    dims: 432
  }
  layout: LAYOUT_ARRAY
  dtype: DTYPE_INT64
  reused: true
  random_data {
    seed: 13005724
    lower_bound: -100.0
    upper_bound: 100.0
